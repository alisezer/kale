#!/bin/sh
# Updates pane option @cc_name on tmux panes running Claude Code or Antigravity (agy),
# and syncs project session auto-renames when an agent's session title changes.
# Run from status-right in ~/.tmux.conf every status-interval; prints nothing.
# tmux runs #() once per attached client, and every `tmux set` redraws every client in full, so:
# run at most once per 4 s across all clients, and only set tmux options when the value changed.
stamp="${XDG_RUNTIME_DIR:-/tmp}/tmux-claude-title.stamp"
now=$(date +%s)
[ "$((now - $(cat "$stamp" 2>/dev/null || echo 0)))" -lt 4 ] && exit 0
echo "$now" > "$stamp"
kale_bin="${HOME}/.local/bin/kale"
[ -x "$kale_bin" ] || kale_bin="kale"
exec "$kale_bin" tmux-titles >/dev/null 2>&1
